# =============================================================================
# Nautilus Agent Platform 环境变量模板
# 使用：cp .env.example .env && 按需修改（.env 已被 .gitignore 排除，禁止提交）
# 规范：禁止硬编码密钥/地址（开发规范红线 #3）；docker-compose 自动读取本文件
# =============================================================================

# ===== 运行环境 =====
APP_ENV=dev
LOG_LEVEL=INFO

# ===== 端口规划（宿主机端口，容器内端口固定，详见 docs/DOCKER.md 5.2）=====
AGENT_PORT=8100
MCP_GATEWAY_PORT=8101
CONDUCTOR_UI_PORT=5000
POSTGRES_PORT=5432
CLINIC_API_PORT=8087

# ===== PostgreSQL（容器名 postgres，容器内通信端口 5432）=====
POSTGRES_VERSION=16
POSTGRES_USER=nautilus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nautilus_agent
# 注意：容器编排会基于上面三项自动拼装 DATABASE_URL 注入服务，本地裸跑时才需要下面这行
# DATABASE_URL=postgresql+asyncpg://nautilus:change-me@localhost:5432/nautilus_agent

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== LLM（OpenAI 兼容协议，支持国内大模型自定义 base-url）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== MCP 网关（Agent 经容器名访问）=====
MCP_GATEWAY_URL=http://mcp-gateway:8101/mcp

# ===== Conductor BPM =====
CONDUCTOR_BASE_URL=http://conductor-server:8080
CONDUCTOR_PURCHASE_WORKFLOW=purchase_approval

# ===== 业务底座（诊所系统）=====
CLINIC_API_BASE=http://nautilus-clinic:8087
CLINIC_API_TOKEN=
# 真实诊所底座 JWT 密钥（--profile clinic 启动时注入业务系统）
CLINIC_JWT_SECRET=nautilus-clinic-dev-secret-please-change-32bytes
# 库存查询/采购下单/发药接口路径（对接真实 ERP/HIS 时替换为实际路由）
INVENTORY_LIST_PATH=/clinic/agent/inventory
PURCHASE_ORDER_PATH=/clinic/agent/purchase/order
DISPENSE_PATH=/clinic/consultation/dispense

# ===== 业务规则（企业可配置，禁止硬编码）=====
INVENTORY_SAFETY_THRESHOLD=10.0
PURCHASE_DEFAULT_SUPPLIER=

# ===== 稳定性：熔断 / 幂等 =====
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_SECONDS=30
IDEMPOTENCY_ENABLED=true

# ===== API 安全（生产开启）=====
API_AUTH_ENABLED=false
API_AUTH_KEY=

# ===== P2 用户认证（JWT 登录，生产必须开启并替换密钥）=====
AUTH_ENABLED=true
AUTH_JWT_SECRET=nautilus-dev-jwt-secret-change-me-32b
# 种子账号（首次启动自动创建，生产必须立即改密）：
#   admin/Admin@123 · purchaser/Purchase@123 · viewer/Viewer@123

# ===== LangSmith 可观测（可选）=====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nautilus-agent
